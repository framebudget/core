{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@framebudget/core": ["./packages/core/src/index.ts"],
      "@framebudget/core/boot": ["./packages/core/src/boot/index.ts"],
      "@framebudget/core/panel": ["./packages/core/src/panel/index.ts"],
      "@framebudget/react": ["./packages/react/src/index.ts"]
    }
  },
  "include": ["packages/*/src"]
}
