{
  "name": "@framebudget/vue",
  "version": "0.5.0",
  "description": "Vue composables for framebudget: useBudget, useTier and provideBudget.",
  "license": "MIT",
  "homepage": "https://framebudget.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framebudget/core.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/framebudget/core/issues"
  },
  "keywords": [
    "performance",
    "animation",
    "frame budget",
    "device capability",
    "adaptive loading",
    "prefers-reduced-motion",
    "vue",
    "composables"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@framebudget/core": "0.5.0"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
