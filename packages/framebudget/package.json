{
  "name": "framebudget",
  "version": "0.1.0",
  "description": "Decides, per device, which visual effects a site can afford. Keep the effects. Lose the stutter.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "performance",
    "animation",
    "frame budget",
    "device capability",
    "adaptive loading",
    "prefers-reduced-motion",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./boot": {
      "types": "./dist/boot.d.ts",
      "import": "./dist/boot.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "boot": "node scripts/build-boot.mjs",
    "build": "node scripts/build-boot.mjs && tsup",
    "test": "node scripts/build-boot.mjs && vitest run",
    "typecheck": "node scripts/build-boot.mjs && tsc --noEmit && tsc --noEmit -p test",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.1",
    "react": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
