{
  "name": "framebudget",
  "version": "0.5.0",
  "description": "Decides, per device, which visual effects a site can afford. Keep the effects. Lose the stutter.",
  "license": "MIT",
  "homepage": "https://framebudget.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framebudget/core.git",
    "directory": "packages/framebudget"
  },
  "bugs": {
    "url": "https://github.com/framebudget/core/issues"
  },
  "keywords": [
    "performance",
    "animation",
    "frame budget",
    "device capability",
    "adaptive loading",
    "prefers-reduced-motion",
    "react",
    "vue",
    "angular"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./boot": {
      "types": "./dist/boot.d.ts",
      "import": "./dist/boot.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@framebudget/angular": "0.5.0",
    "@framebudget/core": "0.5.0",
    "@framebudget/react": "0.5.0",
    "@framebudget/vue": "0.5.0"
  },
  "peerDependencies": {
    "@angular/core": ">=18",
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
