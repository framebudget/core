  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --root ../.. packages/angular/test"
  },
  "dependencies": {
    "@framebudget/core": "0.9.0"
  },
  "peerDependencies": {
    "@angular/core": ">=18"
  },
  "peerDependenciesMeta": {
