{
  "name": "@framebudget/angular",
  "version": "0.9.0",
  "description": "Angular signals for framebudget: injectBudget, injectTier and provideBudget.",
  "license": "MIT",
  "author": "Aly <aly@alysson.dev>",
  "homepage": "https://framebudget.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/framebudget/core.git",
    "directory": "packages/angular"
  },
  "bugs": {
    "url": "https://github.com/framebudget/core/issues"
  },
  "keywords": [
    "performance",
    "animation",
    "frame budget",
    "device capability",
    "adaptive loading",
    "prefers-reduced-motion",
