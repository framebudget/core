{
  "name": "@framebudget/monorepo",
  "private": true,
  "description": "Workspace root of the framebudget packages: @framebudget/core, @framebudget/react and framebudget.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "boot": "node packages/core/scripts/build-boot.mjs",
    "build": "npm run build -w packages/core && npm run build -w packages/react && npm run build -w packages/framebudget",
    "test": "node packages/core/scripts/build-boot.mjs && vitest run && node --test scripts/release/*.test.mjs",
    "typecheck": "node packages/core/scripts/build-boot.mjs && tsc --noEmit && tsc --noEmit -p packages/core/test",
    "size": "node scripts/size.mjs",
    "pack": "node scripts/pack.mjs",
    "lint": "node packages/core/scripts/build-boot.mjs && eslint --max-warnings=0 .",
    "lint:fix": "node packages/core/scripts/build-boot.mjs && eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "release:notes": "node scripts/release/notes.mjs",
    "release:art": "node scripts/release/render-art.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "react": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "esbuild": "^0.28.2"
  },
  "lint-staged": {
    "{packages,scripts}/**/*.{ts,js,mjs}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "{eslint.config.js,vitest.config.ts}": [
      "eslint --max-warnings=0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "{package.json,packages/*/package.json,tsconfig.json,packages/*/tsconfig*.json,packages/*/test/tsconfig.json}": [
      "prettier --write"
    ]
  }
}
