{
  "$description": "framebudget design tokens (Design Tokens Community Group format). Mirrors tokens.css. Dark is the default theme; the light roles exist only for documentation themes.",
  "color": {
    "base": {
      "deep": { "$type": "color", "$value": "#0b0e1e", "$description": "Below the page: tracks, code blocks, the install line" },
      "night": { "$type": "color", "$value": "#0f1225", "$description": "Default page background" },
      "ink": { "$type": "color", "$value": "#161a2e", "$description": "Panels and the mark tile" },
      "ink-raised": { "$type": "color", "$value": "#1f2440", "$description": "Controls, selected and hover states" },
      "ink-line": { "$type": "color", "$value": "#2a3052", "$description": "Hairlines between surfaces" },
      "ink-line-strong": { "$type": "color", "$value": "#5f6896", "$description": "Control borders, 3.2:1 on Ink" },
      "chalk": { "$type": "color", "$value": "#e8ebf2", "$description": "Text, 15.5:1 on Night" },
      "mist": { "$type": "color", "$value": "#9aa3bc", "$description": "Muted text, 7.4:1 on Night, 6.0:1 on Ink raised" },
      "vsync": { "$type": "color", "$value": "#ff5a92", "$description": "Accent. The 16.7 ms deadline and focus. One per view. 6.3:1 on Night" },
      "grid": { "$type": "color", "$value": "#eef1f5", "$description": "Light docs page background" },
      "paper": { "$type": "color", "$value": "#ffffff", "$description": "Light docs surfaces" },
      "rule": { "$type": "color", "$value": "#d5dae4", "$description": "Light docs hairlines" },
      "slate": { "$type": "color", "$value": "#545c73", "$description": "Light docs muted text, 5.9:1 on Grid" },
      "vsync-deep": { "$type": "color", "$value": "#d1185e", "$description": "Accent on light backgrounds, 4.6:1 on Grid" }
    },
    "effect": {
      "$description": "Work that spends frame time. Fills, labelled in Night, which passes AA on each (ratio in the description).",
      "app": { "$type": "color", "$value": "#7d86a6", "$description": "Pewter. The site's own work, not an effect. 5.2:1. Light docs use Stone #b8c0d0" },
      "parallax": { "$type": "color", "$value": "#f2b21b", "$description": "Amber. 9.8:1" },
      "page-transition": { "$type": "color", "$value": "#9474f2", "$description": "Violet. 5.3:1" },
      "canvas": { "$type": "color", "$value": "#2fb67c", "$description": "Mint. 7.2:1" },
      "sound": { "$type": "color", "$value": "#1fa6ca", "$description": "Cyan. 6.5:1" },
      "blur": { "$type": "color", "$value": "#6482f5", "$description": "Blue. 5.3:1" },
      "label": { "$type": "color", "$value": "{color.base.night}" }
    },
    "code": {
      "$description": "Syntax colors on code-background (Deep) in both themes.",
      "keyword": { "$type": "color", "$value": "#c4b1ff", "$description": "10.1:1" },
      "string": { "$type": "color", "$value": "#86e3b9", "$description": "12.5:1" },
      "function": { "$type": "color", "$value": "#f7cd63", "$description": "12.7:1" },
      "number": { "$type": "color", "$value": "#ff8fb6", "$description": "9.0:1" },
      "comment": { "$type": "color", "$value": "{color.base.mist}", "$description": "7.6:1" }
    },
    "role": {
      "dark": {
        "$description": "Default theme.",
        "background": { "$type": "color", "$value": "{color.base.night}" },
        "surface": { "$type": "color", "$value": "{color.base.ink}" },
        "surface-raised": { "$type": "color", "$value": "{color.base.ink-raised}" },
        "surface-sunken": { "$type": "color", "$value": "{color.base.deep}" },
        "border": { "$type": "color", "$value": "{color.base.ink-line}" },
        "border-strong": { "$type": "color", "$value": "{color.base.ink-line-strong}" },
        "text": { "$type": "color", "$value": "{color.base.chalk}" },
        "muted": { "$type": "color", "$value": "{color.base.mist}" },
        "accent": { "$type": "color", "$value": "{color.base.vsync}" },
        "accent-text": { "$type": "color", "$value": "{color.base.night}" },
        "focus": { "$type": "color", "$value": "{color.base.vsync}" },
        "button": { "$type": "color", "$value": "{color.base.chalk}" },
        "button-hover": { "$type": "color", "$value": "#ffffff" },
        "button-text": { "$type": "color", "$value": "{color.base.night}" },
        "code-background": { "$type": "color", "$value": "{color.base.deep}" },
        "code-border": { "$type": "color", "$value": "{color.base.ink-line}" },
        "code-text": { "$type": "color", "$value": "{color.base.chalk}" },
        "code-muted": { "$type": "color", "$value": "{color.base.mist}" }
      },
      "light": {
        "$description": "Documentation themes only. Opt in with data-theme=\"light\". Code roles stay as in dark.",
        "background": { "$type": "color", "$value": "{color.base.grid}" },
        "surface": { "$type": "color", "$value": "{color.base.paper}" },
        "surface-raised": { "$type": "color", "$value": "{color.base.paper}" },
        "surface-sunken": { "$type": "color", "$value": "#e4e8ef" },
        "border": { "$type": "color", "$value": "{color.base.rule}" },
        "border-strong": { "$type": "color", "$value": "#7d859b" },
        "text": { "$type": "color", "$value": "{color.base.ink}" },
        "muted": { "$type": "color", "$value": "{color.base.slate}" },
        "accent": { "$type": "color", "$value": "{color.base.vsync-deep}" },
        "accent-text": { "$type": "color", "$value": "#ffffff" },
        "focus": { "$type": "color", "$value": "{color.base.vsync-deep}" },
        "button": { "$type": "color", "$value": "{color.base.ink}" },
        "button-hover": { "$type": "color", "$value": "{color.base.ink-raised}" },
        "button-text": { "$type": "color", "$value": "#ffffff" }
      }
    },
    "tier": {
      "$description": "A device's allowance. Each pair passes WCAG AA as text on its tint (ratio in the description).",
      "dark": {
        "full": { "fg": { "$type": "color", "$value": "#5fd6a2" }, "bg": { "$type": "color", "$value": "#133a30" }, "$description": "6.9:1" },
        "high": { "fg": { "$type": "color", "$value": "#8db4ff" }, "bg": { "$type": "color", "$value": "#1b2d57" }, "$description": "6.5:1" },
        "medium": { "fg": { "$type": "color", "$value": "#f5c35b" }, "bg": { "$type": "color", "$value": "#3a2f1c" }, "$description": "8.0:1" },
        "lite": { "fg": { "$type": "color", "$value": "#b4bbcf" }, "bg": { "$type": "color", "$value": "#272c4a" }, "$description": "7.1:1" }
      },
      "light": {
        "full": { "fg": { "$type": "color", "$value": "#0f7a4f" }, "bg": { "$type": "color", "$value": "#e3f4ec" }, "$description": "4.7:1" },
        "high": { "fg": { "$type": "color", "$value": "#1d5fc0" }, "bg": { "$type": "color", "$value": "#e4edfb" }, "$description": "5.2:1" },
        "medium": { "fg": { "$type": "color", "$value": "#9a5b00" }, "bg": { "$type": "color", "$value": "#fbf0dc" }, "$description": "4.8:1" },
        "lite": { "fg": { "$type": "color", "$value": "#5a637a" }, "bg": { "$type": "color", "$value": "#e6e9f0" }, "$description": "4.9:1" }
      }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Archivo", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "SIL OFL 1.1. Variable: weight 400-800, width 100-125" },
      "mono": { "$type": "fontFamily", "$value": ["Martian Mono", "ui-monospace", "monospace"], "$description": "SIL OFL 1.1. Variable: weight 400-700" }
    },
    "width": {
      "display": { "$type": "number", "$value": 112, "$description": "font-stretch percent for headings" },
      "text": { "$type": "number", "$value": 100 }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 520 },
      "bold": { "$type": "fontWeight", "$value": 680 },
      "heavy": { "$type": "fontWeight", "$value": 780 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "md": { "$type": "dimension", "$value": "18px" },
      "lg": { "$type": "dimension", "$value": "21px" },
      "xl": { "$type": "dimension", "$value": "24px" },
      "2xl": { "$type": "dimension", "$value": "36px" },
      "3xl": { "$type": "dimension", "$value": "48px" },
      "4xl": { "$type": "dimension", "$value": "60px" },
      "5xl": { "$type": "dimension", "$value": "72px" }
    },
    "leading": {
      "tight": { "$type": "number", "$value": 1.05 },
      "snug": { "$type": "number", "$value": 1.25 },
      "text": { "$type": "number", "$value": 1.55 }
    },
    "tracking": {
      "display": { "$type": "dimension", "$value": "-0.02em" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" },
    "8": { "$type": "dimension", "$value": "64px" },
    "9": { "$type": "dimension", "$value": "96px" },
    "10": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "segment": { "$type": "dimension", "$value": "2px" },
    "control": { "$type": "dimension", "$value": "6px" },
    "panel": { "$type": "dimension", "$value": "12px" },
    "tile": { "$type": "dimension", "$value": "25%", "$description": "The mark tile: 8 units on a 32 unit grid" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "motion": {
    "frame": { "$type": "duration", "$value": "16.7ms" },
    "duration": {
      "6f": { "$type": "duration", "$value": "100ms", "$description": "Press feedback" },
      "10f": { "$type": "duration", "$value": "167ms", "$description": "An effect leaving the frame" },
      "16f": { "$type": "duration", "$value": "267ms", "$description": "An effect settling into the frame" },
      "30f": { "$type": "duration", "$value": "500ms", "$description": "A full reshuffle of the frame" }
    },
    "easing": {
      "settle": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1], "$description": "Arrivals: fast start, soft landing, no overshoot" },
      "drop": { "$type": "cubicBezier", "$value": [0.5, 0, 0.9, 0.4], "$description": "Exits: leave quickly, no lingering" },
      "meter": { "$type": "cubicBezier", "$value": [0.3, 0, 0.3, 1], "$description": "Values moving along a scale" }
    }
  }
}
